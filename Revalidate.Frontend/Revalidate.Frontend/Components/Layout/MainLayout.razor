@inherits LayoutComponentBase
@inject NavigationManager NavManager

@inject IConfiguration Config

@using SimplestGitSourceGenerator

<ReuNavMenu Brand="revalidate.gbx.tools">
    <ReuNavItem Name="Validate" Href="" IconType="IconType.Home" NavLinkMatch="NavLinkMatch.All"></ReuNavItem>
    @*<ReuNavItem Name="Results" Href="results" IconType="IconType.Results"></ReuNavItem>*@
    <ReuNavItem Name="About" Href="about" IconType="IconType.Info"></ReuNavItem>
    <ReuNavItem Name="API" Href="@($"{GetPublicBaseUrl()}/scalar")" IconType="IconType.API" IsNavLink="false" IconOnly="true"></ReuNavItem>
    <ReuNavItem Name="Docker" Href="https://hub.docker.com/r/bigbang1112/revalidate" IconType="IconType.Docker" IsNavLink="false" IconOnly="true" IconWidth="30" IconHeight="30"></ReuNavItem>
    <ReuNavItem Name="GitHub" Href="https://github.com/BigBang1112/revalidate" IconType="IconType.GitHub" IsNavLink="false" IconOnly="true" IconWidth="28" IconHeight="28"></ReuNavItem>
    <ReuNavItem Name="Discord" Href="https://discord.gbx.tools" IconType="IconType.Discord" IsNavLink="false" IconOnly="true" Title="Join the Discord server"></ReuNavItem>
    <AuthorizeView>
        <Authorized>
            <ReuNavItem Name="Profile" Href="profile" IconType="IconType.Person" IconOnly="true" Title="Profile"></ReuNavItem>
        </Authorized>
        <NotAuthorized>
            <ReuNavItem Name="Login" Href="@($"login?returnUrl={Uri.EscapeDataString(NavManager.BaseUri)}")" IconType="IconType.Login" IsNavLink="false" IconOnly="true" Title="Login"></ReuNavItem>
        </NotAuthorized>
    </AuthorizeView>
</ReuNavMenu>

<ReuMain>
    <ReuContainer>
        @Body
    </ReuContainer>
</ReuMain>

<ReuFooter>
    <CopyrightContent>
        © 2025-2026 Petr '<a href="https://bigbang1112.cz">BigBang1112</a>' Pivoňka<br />
        <small>
            Not affiliated with or endorsed by Nadeo or Ubisoft.
            All relevant trademarks belong to their respective owners.
        </small>
    </CopyrightContent>
    <LinkContent>
        <a href="terms">Terms of Service</a>
        <a href="privacy">Privacy Policy</a>
        <a href="@($"{GetPublicBaseUrl()}/scalar")">API</a>
        <AuthorizeView>
            <Authorized>
                <a href="logout">Logout</a>
            </Authorized>
        </AuthorizeView>
    </LinkContent>
    <ExtraContent>
        <div class="footer-discover-more">
            <span>Discover more:</span>
            <a href="https://gbx.tools">gbx.tools</a>
            <a href="https://explorer.gbx.tools">explorer.gbx.tools</a>
            <a href="https://3d.gbx.tools">3d.gbx.tools</a>
            <a href="https://io.gbx.tools">io.gbx.tools</a>
            <a href="https://nc.gbx.tools">nc.gbx.tools</a>
            <span>revalidate.gbx.tools</span>
            <a href="https://envimix.gbx.tools">envimix.gbx.tools</a>
            <a href="https://uotd.gbx.tools">uotd.gbx.tools</a>
            <a href="https://identity.gbx.tools">identity.gbx.tools</a>
            <a href="https://nuget.gbx.tools">nuget.gbx.tools</a>
            <code>
                @{
                    var remoteUrl = SimplestGit.RemoteUrl.EndsWith(".git") ? SimplestGit.RemoteUrl.Substring(0, SimplestGit.RemoteUrl.Length - 4) : SimplestGit.RemoteUrl;
                }
                <a href="@remoteUrl/tree/@SimplestGit.CommitHash" title="@SimplestGit.CommitDate" target="_blank">
                    @SimplestGit.Tag
                </a>
            </code>
        </div>
    </ExtraContent>
</ReuFooter>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    string? GetPublicBaseUrl()
    {
        var baseUrl = Config["API:PublicBaseUrl"];

        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            return Config["API:BaseAddress"];
        }

        return baseUrl;
    }
}