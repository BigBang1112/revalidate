@page "/profile"
@using System.Security.Claims
@attribute [Authorize]
@attribute [StreamRendering]

<PageTitle>Profile - Revalidate</PageTitle>

<h1>Profile</h1>

<AuthorizeView>
    <Authorized>
        <p>Welcome, @(context.User.Identity?.Name ?? context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value)!</p>
        <p>This is your profile page.</p>
    </Authorized>
</AuthorizeView>
